{
  "name": "thumpcut-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "prebuild": "expo prebuild --clean",
