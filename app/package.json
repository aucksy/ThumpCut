  },
  "dependencies": {
    "@thumpcut/cut-engine": "*",
    "@thumpcut/design-tokens": "*",
    "expo": "55.0.28",
    "expo-audio": "55.0.16",
    "expo-build-properties": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-file-system": "55.0.24",
    "expo-font": "55.0.8",
    "expo-image": "55.0.11",
    "expo-image-picker": "55.0.22",
    "expo-intent-launcher": "55.0.14",
    "expo-keep-awake": "~55.0.8",
    "expo-linking": "55.0.16",
    "expo-media-library": "55.0.19",
    "expo-router": "55.0.17",
    "expo-splash-screen": "55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-video": "55.0.19",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
