# Copy this file to .env and fill in the values.
# The build does NOT require these — the Factory runs in fixture mode without them,
# and every automated check passes with this file untouched.

# ---- Meta / Instagram Audio API (Phase 1: real track discovery + audio) ----
# Needs an Instagram Business or Creator account linked to a Facebook Page,
# and a Meta app with instagram_basic + instagram_content_publish permissions.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
IG_USER_ID=

# ---- Beat engine (optional) ----
# spectral_dp (default, pure NumPy) or beat_this (higher accuracy, needs PyTorch).
BEAT_ENGINE=

# ---- Meta App ID for the Instagram share handoff (Phase 7) ----
# The same app ID as above. The app needs it at build time; without it, Instagram
# silently ignores the share.
EXPO_PUBLIC_META_APP_ID=

# ---- Cloudflare R2 (Phase 1: publishing the catalogue) ----
# Without these, the Factory writes output locally to factory/out/ instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=thumpcut-catalogue
R2_PUBLIC_URL=

# ---- App: where to fetch the catalogue from (Phase 3) ----
# Point this at your R2 public URL, or at a local server during development.
EXPO_PUBLIC_CATALOGUE_URL=
